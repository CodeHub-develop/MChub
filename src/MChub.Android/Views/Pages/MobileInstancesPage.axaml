<UserControl
    x:Class="MChub.Mobile.Views.Pages.MobileInstancesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ore="using:OreUI.Controls"
    xmlns:loc="using:MChub.Localization"
    xmlns:classes="using:MChub.Core.Minecraft.Classes">
    <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_instancesTitle}}" />
            <Button
                Grid.Column="1"
                Classes="ore secondary"
                Content="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_instancesRefresh}}"
                Click="Refresh_OnClick" />
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            FontSize="12"
            Opacity="0.7"
            TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <TextBlock
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="False"
                Opacity="0.6"
                Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_instancesEmpty}}" />

            <ListBox x:Name="InstanceList" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="classes:MinecraftInstance">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{Binding InstanceName}" />
                                <TextBlock FontSize="12" Opacity="0.6" Text="{Binding Type}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Classes="ore hero"
                                Content="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_instancesLaunch}}"
                                Click="Launch_OnClick" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
