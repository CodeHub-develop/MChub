<UserControl
    x:Class="MChub.Mobile.Views.Pages.MobileSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ore="using:OreUI.Controls"
    xmlns:loc="using:MChub.Localization">
    <ScrollViewer>
        <StackPanel Margin="12" Spacing="4">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsTitle}}" />

            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Opacity="0.6"
                           Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsLanguage}}" />
                <TextBlock x:Name="LanguageValue" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Grid.Column="0" Opacity="0.6"
                           Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsTheme}}" />
                <TextBlock x:Name="ThemeValue" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Grid.Column="0" Opacity="0.6"
                           Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsVersion}}" />
                <TextBlock x:Name="VersionValue" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />

                <TextBlock Grid.Row="3" Grid.Column="0" Opacity="0.6"
                           Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsStorageTitle}}" />
                <TextBlock x:Name="StorageValue" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>

            <ore:OreDivider Classes="horizontal" Margin="0,12" />

            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsRuntimeTitle}}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ore:OreTag x:Name="RuntimeTag"
                            Content="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsRuntimePending}}" />
            </StackPanel>
            <TextBlock
                x:Name="RuntimeHint"
                FontSize="12"
                Opacity="0.6"
                TextWrapping="Wrap"
                Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsRuntimePlanned}}" />

            <TextBlock
                x:Name="CoreStatusText"
                Margin="0,12,0,0"
                FontSize="12"
                Opacity="0.6"
                TextWrapping="Wrap"
                IsVisible="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
