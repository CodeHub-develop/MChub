<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush
                Color="White"
                Opacity="0.12"
                x:Key="TabBackground" />
            <SolidColorBrush
                Color="{DynamicResource SystemAccentColorLight3}"
                Opacity="0.15"
                x:Key="TabHover" />
            <SolidColorBrush
                Color="{DynamicResource SystemAccentColorLight3}"
                Opacity="0.3"
                x:Key="TabSelected" />
            <BoxShadows x:Key="PopupBoxShadow">0 0 8 1 #35000000</BoxShadows>
            <!-- Skeleton 占位 Fluent 化：统一用中性深灰底，平滑主题过渡 -->
            <SolidColorBrush Color="#1C1F23" x:Key="SkeletonDefaultBackground" />
            <SolidColorBrush Color="#24272B" x:Key="SkeletonStartAnimationBackground" />
            <SolidColorBrush Color="#2E3238" x:Key="SkeletonEndAnimationBackground" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
